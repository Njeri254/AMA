{
  "kind": "collectionType",
  "collectionName": "reports",
  "info": {
    "singularName": "report",
    "pluralName": "reports",
    "displayName": "Reports"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Year": {
      "type": "biginteger"
    },
    "Category": {
      "type": "enumeration",
      "enum": [
        "Annual Reports",
        "Newsletters",
        "Strategic Plans"
      ]
    },
    "PDF": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Description": {
      "type": "blocks"
    },
    "Published": {
      "type": "datetime"
    }
  }
}
